@InProceedings{BSIDH,
author="Costello, Craig",
editor="Moriai, Shiho
and Wang, Huaxiong",
title="B-SIDH: Supersingular Isogeny Diffie-Hellman Using Twisted Torsion",
booktitle="Advances in Cryptology -- ASIACRYPT 2020",
year="2020",
publisher="Springer International Publishing",
address="Cham",
pages="440--463",
abstract="This paper explores a new way of instantiating isogeny-based cryptography in which parties can work in both the {\$}{\$}(p+1){\$}{\$}(p+1)-torsion of a set of supersingular curves and in the {\$}{\$}(p-1){\$}{\$}(p-1)-torsion corresponding to the set of their quadratic twists. Although the isomorphism between a given supersingular curve and its quadratic twist is not defined over {\$}{\$}{\backslash}mathbb {\{}F{\}}{\_}{\{}p^2{\}}{\$}{\$}Fp2in general, restricting operations to the x-lines of both sets of twists allows all arithmetic to be carried out over {\$}{\$}{\backslash}mathbb {\{}F{\}}{\_}{\{}p^2{\}}{\$}{\$}Fp2as usual. Furthermore, since supersingular twists always have the same {\$}{\$}{\backslash}mathbb {\{}F{\}}{\_}{\{}p^2{\}}{\$}{\$}Fp2-rational j-invariant, the SIDH protocol remains unchanged when Alice and Bob are free to work in both sets of twists.",
isbn="978-3-030-64834-3"
}



